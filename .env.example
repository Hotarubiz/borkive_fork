# 쓰려면 이 파일을 .env 로 복사해서 고치세요 (없어도 기본값으로 돌아가요)
# Portainer는 이 파일 대신 스택 화면의 'Environment variables'에 같은 이름·값을 넣어요.

# PocketRisu 연동용 봇카이브 도메인(리버스 프록시 주소). https://는 안 적어도 돼요. 비워 두면 연동만 꺼져요. 예: xxx.xxxx.synology.me
BOTKIVE_LINK_ORIGIN=

# 브라우저에서 들어갈 포트: http://127.0.0.1:8391
BOTSHELF_PORT=8391

# 포트를 열 주소. 기본 127.0.0.1(이 컴퓨터·NAS 안에서만).
# DSM 역방향 프록시가 NAS 내부 IP로 연결한다면 그 IP를 적어요(예: 192.168.0.10). 0.0.0.0은 쓰지 마세요.
BOTSHELF_BIND_IP=127.0.0.1

# 자료 폴더. 비워 두면 이 폴더의 ./data. NAS·Portainer에서는 절대 경로를 권해요(예: /volume1/docker/botkive/data)
BOTSHELF_DATA_DIR=

# 보통은 비워 두세요 — 자료 폴더 주인에 맞춰 자동으로 골라요. 특정 사용자로 돌리고 싶을 때만 숫자(id -u / id -g)
BOTSHELF_UID=
BOTSHELF_GID=

# 시간대 (화면에 나오는 날짜)
TZ=Asia/Seoul

# 잠금 비밀번호를 잊었을 때만: 1로 바꾸고 다시 배포 → 잠금이 풀려요. 풀린 뒤 다시 비우고 다시 배포
BOTSHELF_RESET_AUTH=
